---
import '../styles/global.css';
import { chapters, dashboard, url } from '../site';

interface Props {
  title: string;
  description?: string;
  /** Path relative to base used to highlight the active nav item. */
  active?: string;
  /** Wider content area for the dashboard. */
  app?: boolean;
}

const {
  title,
  description = "How metro Atlanta's electricity is made, moved and used, and what different choices could change.",
  active = '',
  app = false,
} = Astro.props;
const fullTitle = title === 'Atlanta Energyshed' ? title : `${title} | Atlanta Energyshed`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body class:list={['shell', app && 'is-app']}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <a class="brand brand--compact" href={url('')}>Atlanta Energyshed</a>
      <div class="topbar__actions">
        <button class="theme-toggle theme-toggle--icon" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode">
          <span class="theme-toggle__sun" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 3v1.5M12 19.5V21M4.2 4.2l1.1 1.1M18.7 18.7l1.1 1.1M3 12h1.5M19.5 12H21M4.2 19.8l1.1-1.1M18.7 5.3l1.1-1.1" />
            </svg>
          </span>
          <span class="theme-toggle__moon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 14.3A8.5 8.5 0 0 1 9.7 3 7 7 0 1 0 21 14.3z" />
            </svg>
          </span>
        </button>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="sidebar">Menu</button>
      </div>
    </header>

    <aside id="sidebar" class="sidebar">
      <a class="brand" href={url('')}>
        <span class="brand__name">Atlanta Energyshed</span>
        <span class="brand__tag">How the region's power is made, moved and used</span>
      </a>

      <nav aria-label="Site">
        <p class="sidebar__group" id="nav-learn">Learn</p>
        <ol class="sidebar__list" aria-labelledby="nav-learn">
          {chapters.map((c, i) => (
            <li>
              <a href={url(c.slug)} aria-current={active === c.slug ? 'page' : undefined}>
                <span class="sidebar__num">{i + 1}</span>
                {c.title}
              </a>
            </li>
          ))}
        </ol>

        <p class="sidebar__group" id="nav-explore">Explore</p>
        <ul class="sidebar__list" aria-labelledby="nav-explore">
          <li>
            <a href={url('future/')} aria-current={active === 'future/' ? 'page' : undefined}>
              <span class="sidebar__dot" style="background: var(--fuel-solar)"></span>
              <span class="sidebar__link-text">
                Looking to the future
                <span class="sidebar__sub">Unfinished section</span>
              </span>
            </a>
          </li>
          <li>
            <a href={url(dashboard.slug)} aria-current={active === dashboard.slug ? 'page' : undefined}>
              <span class="sidebar__dot" style="background: var(--fuel-nuclear)"></span>
              {dashboard.title}
            </a>
          </li>
        </ul>

        <p class="sidebar__group" id="nav-about">About</p>
        <ul class="sidebar__list" aria-labelledby="nav-about">
          <li>
            <a href="https://energyshed.research.gatech.edu/">
              <span class="sidebar__dot sidebar__dot--hollow"></span>
              Project website
            </a>
          </li>
        </ul>
      </nav>

      <div class="sidebar__foot">
        <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode">
          <span class="theme-toggle__sun" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 3v1.5M12 19.5V21M4.2 4.2l1.1 1.1M18.7 18.7l1.1 1.1M3 12h1.5M19.5 12H21M4.2 19.8l1.1-1.1M18.7 5.3l1.1-1.1" />
            </svg>
          </span>
          <span class="theme-toggle__moon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 14.3A8.5 8.5 0 0 1 9.7 3 7 7 0 1 0 21 14.3z" />
            </svg>
          </span>
          <span class="theme-toggle__copy">
            <span class="theme-toggle__kind">Appearance</span>
            <span data-theme-label>Light</span>
          </span>
        </button>
        <dl class="sidebar__meta">
          <div><dt>Map areas</dt><dd>3</dd></div>
          <div><dt>Dashboard data</dt><dd>Mock</dd></div>
        </dl>
      </div>
    </aside>

    <div class="shell__main">
      <main id="main" class:list={['main', app && 'main--app']}>
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          A communication tool of the Georgia Tech{' '}
          <a href="https://energyshed.research.gatech.edu/">Atlanta Energyshed project</a>, with the Atlanta Regional Commission.
          Figures marked as mock-ups are illustrative and not model output.
        </p>
      </footer>
    </div>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const sidebar = document.getElementById('sidebar');
      const setOpen = (open: boolean) => {
        toggle?.setAttribute('aria-expanded', String(open));
        sidebar?.classList.toggle('is-open', open);
        document.body.classList.toggle('nav-open', open);
      };
      toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sidebar?.classList.contains('is-open')) {
          setOpen(false);
          toggle?.focus();
        }
      });

      const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      const resolvedTheme = (): 'light' | 'dark' =>
        document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      const syncTheme = (theme: 'light' | 'dark') => {
        themeButtons.forEach((btn) => {
          btn.setAttribute('aria-pressed', String(theme === 'dark'));
          btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
          const label = btn.querySelector('[data-theme-label]');
          if (label) label.textContent = theme === 'dark' ? 'Dark' : 'Light';
        });
      };
      const setTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        syncTheme(theme);
      };
      themeButtons.forEach((btn) => {
        btn.addEventListener('click', () => setTheme(resolvedTheme() === 'dark' ? 'light' : 'dark'));
      });
      syncTheme(resolvedTheme());
    </script>
  </body>
</html>

<style>
  .shell { min-height: 100vh; }
  @media (min-width: 1024px) {
    .shell {
      display: grid;
      grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
      background: linear-gradient(90deg, var(--sidebar) var(--sidebar-w), var(--paper) var(--sidebar-w));
    }
  }

  /* ---- Sidebar ---- */
  .sidebar {
    background: var(--sidebar);
    color: var(--sidebar-ink);
    display: flex;
    flex-direction: column;
    padding: 22px 14px 18px;
    gap: 6px;
  }
  @media (min-width: 1024px) {
    .sidebar { position: sticky; top: 0; height: 100vh; overflow-y: auto; }
  }

  .brand { display: block; color: var(--sidebar-ink); text-decoration: none; padding: 0 8px 14px; }
  .brand__name { display: block; font-weight: 750; font-size: 1.05rem; letter-spacing: -0.01em; }
  .brand__tag { display: block; color: var(--sidebar-muted); font-size: 0.8rem; line-height: 1.35; margin-top: 4px; }

  .sidebar__group {
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sidebar-muted);
    margin: 18px 8px 6px;
  }
  .sidebar__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .sidebar__list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--sidebar-ink);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .sidebar__list a:hover { background: var(--sidebar-active); }
  .sidebar__list a[aria-current='page'] { background: var(--sidebar-active); font-weight: 650; }
  .sidebar__list a[aria-current='page'] .sidebar__num { background: #fff; color: var(--sidebar); border-color: #fff; }
  .sidebar__list a:focus-visible { outline-color: #9fbaff; }

  .sidebar__num {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    border: 1px solid var(--sidebar-muted);
    color: var(--sidebar-muted);
    font-size: 0.7rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    font-variant-numeric: tabular-nums;
  }
  .sidebar__dot { flex: none; width: 8px; height: 8px; border-radius: 999px; margin-inline: 6px; }
  .sidebar__dot--hollow { border: 1.5px solid var(--sidebar-muted); }
  .sidebar__link-text { display: grid; gap: 1px; min-width: 0; }
  .sidebar__sub {
    display: block;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--sidebar-muted);
    line-height: 1.25;
  }

  .sidebar__foot { margin-top: auto; }
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin: 12px 0 0;
    padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: var(--sidebar-active);
    color: var(--sidebar-ink);
    font: 500 0.86rem var(--sans);
    cursor: pointer;
    text-align: left;
  }
  .theme-toggle:hover { background: rgba(255, 255, 255, 0.14); }
  .theme-toggle__copy { display: grid; line-height: 1.2; }
  .theme-toggle__kind {
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sidebar-muted);
  }
  .theme-toggle__sun, .theme-toggle__moon { display: grid; place-items: center; flex: none; }
  .theme-toggle[aria-pressed='false'] .theme-toggle__moon,
  .theme-toggle[aria-pressed='true'] .theme-toggle__sun { display: none; }
  .theme-toggle--icon {
    width: auto;
    margin: 0;
    padding: 7px 9px;
  }
  .theme-toggle--icon .theme-toggle__copy { display: none; }

  .sidebar__meta {
    margin: 12px 0 0;
    padding: 14px 8px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.78rem;
    display: grid;
    gap: 6px;
  }
  .sidebar__meta div { display: flex; justify-content: space-between; gap: 12px; }
  .sidebar__meta dt { color: var(--sidebar-muted); }
  .sidebar__meta dd { margin: 0; font-weight: 600; text-align: right; }

  /* ---- Mobile top bar + drawer ---- */
  .topbar {
    display: none;
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--sidebar);
    color: var(--sidebar-ink);
    padding: 10px var(--gutter);
    align-items: center;
    justify-content: space-between;
  }
  .brand--compact { padding: 0; font-weight: 750; }
  .topbar__actions { display: flex; align-items: center; gap: 8px; }
  .nav-toggle {
    font: 600 0.9rem var(--sans);
    color: var(--sidebar-ink);
    background: var(--sidebar-active);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 7px 12px;
    cursor: pointer;
  }
  @media (max-width: 1023px) {
    .topbar { display: flex; }
    .sidebar {
      position: fixed;
      z-index: 40;
      top: 52px;
      left: 0;
      bottom: 0;
      width: min(300px, 86vw);
      overflow-y: auto;
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform 0.2s ease, visibility 0.2s;
    }
    .sidebar .brand { display: none; }
    .sidebar.is-open { transform: none; visibility: visible; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35); }
  }

  /* ---- Main ---- */
  .main { padding: clamp(20px, 4vw, 40px) var(--gutter) 8px; }
  .main--app { padding-top: clamp(16px, 3vw, 28px); }
  .site-footer {
    padding: 8px var(--gutter) 32px;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .site-footer p { max-width: var(--wide); margin: 0 auto; }
  .is-app .site-footer p { max-width: none; }
</style>
